---
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle"
import V2Banner from "./V2Banner.astro"

const { hasSidebar } = Astro.locals.starlightRoute
---

<div class="page sl-flex">
  <header class="header"><slot name="header" /></header>
  <V2Banner />
  {
    hasSidebar && (
      <nav class="sidebar print:hidden" aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
        <MobileMenuToggle />
        <script>
          // Starlight 0.42 drives the mobile sidebar with the popover API rather than
          // `aria-expanded`, so the pane has to be this custom element for the toggle's
          // `popovertarget` to reach it. Mirrors upstream PageFrame.astro; kept in sync
          // by hand because this file overrides it to add the V2 banner.
          class StarlightSidebarPane extends HTMLElement {
            constructor() {
              super()

              const desktopMediaQuery = matchMedia("(min-width: 50em)")

              // The popover attribute is only wanted for the mobile menu.
              const resetPopoverAttribute = () => {
                this.popover = desktopMediaQuery.matches ? null : "auto"
              }
              resetPopoverAttribute()
              desktopMediaQuery.addEventListener("change", () => resetPopoverAttribute())

              this.addEventListener("toggle", ({ newState }) => this.trapFocus(newState === "open"))
            }
            /** Trap keyboard focus inside the header and menu when the menu is expanded. */
            trapFocus(shouldTrap: boolean) {
              document.querySelectorAll<HTMLElement>(".main-frame, .sl-skip-link").forEach((el) => {
                el.toggleAttribute("inert", shouldTrap)
              })
            }
          }
          customElements.define("sl-sidebar-pane", StarlightSidebarPane)
        </script>
        <sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </sl-sidebar-pane>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
    }

    .sidebar-pane {
      /* User agents apply opinionated styles to popovers, which we do not want. */
      border: unset;
      padding: unset;
      height: unset;
      color: unset;

      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: calc(var(--sl-nav-height) + var(--v2-banner-height)) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: "";
        padding-bottom: 1px;
      }
    }

    .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height) + var(--v2-banner-height));
      padding-inline-start: var(--sl-content-inline-start);
    }

    @media (min-width: 50rem) {
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }
      .sidebar-pane {
        /* Visible on larger screens instead of deferring to popover state. */
        display: block;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }
    }
  }
</style>
