diff --git a/src/download.ts b/src/download.ts
--- a/src/download.ts
+++ b/src/download.ts
@@ -14,0 +15,2 @@
+declare const FFF_BUN_EXTERNAL_LIBRARY: string;
+
@@ -103,0 +106,8 @@
+function resolveCompiledLibraryPath(): string | null {
+  if (typeof FFF_BUN_EXTERNAL_LIBRARY !== "string") return null;
+  if (!import.meta.url.includes("$bunfs")) return null;
+
+  const libraryPath = join(dirname(process.execPath), FFF_BUN_EXTERNAL_LIBRARY);
+  return existsSync(libraryPath) ? libraryPath : null;
+}
+
@@ -113,0 +124,3 @@
+  const compiledLibraryPath = resolveCompiledLibraryPath();
+  if (compiledLibraryPath) return compiledLibraryPath;
+
