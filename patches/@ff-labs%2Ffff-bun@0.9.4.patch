+++ b/src/download.ts
@@ -14,0 +15,2 @@
+declare const FFF_BUN_EXTERNAL_LIBRARY: string;
+
@@ -103,0 +106,11 @@
+export function resolveCompiledLibraryPath(
+  executablePath = process.execPath,
+  filename = typeof FFF_BUN_EXTERNAL_LIBRARY === "string" ? FFF_BUN_EXTERNAL_LIBRARY : undefined,
+  exists = existsSync,
+) {
+  if (!filename) return null;
+
+  const libraryPath = join(dirname(executablePath), filename);
+  return exists(libraryPath) ? libraryPath : null;
+}
